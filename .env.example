# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so real credentials never reach GitHub.

# MySQL connection used by the web app (least-privilege user, created by npm run db:setup)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library
DB_USER=library_app
DB_PASSWORD=

# MySQL admin account, used only by npm run db:setup to build the database
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Secret for signing login tokens (any long random string)
JWT_SECRET=

# Neo4j Desktop (bolt URL shown on the database's Connect panel)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
